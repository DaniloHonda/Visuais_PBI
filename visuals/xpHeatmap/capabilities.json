{
    "dataRoles": [
        {
            "displayName": "Linhas",
            "name": "linhas",
            "kind": "Grouping",
            "description": "Ex.: dEtapa[stage_name]"
        },
        {
            "displayName": "Colunas",
            "name": "colunas",
            "kind": "Grouping",
            "description": "Ex.: dFaixaDias[faixa], classificada pela ordem"
        },
        {
            "displayName": "Valor",
            "name": "valor",
            "kind": "Measure",
            "description": "Ex.: Esteira | Ativos na Faixa"
        },
        {
            "displayName": "Base da taxa (opcional)",
            "name": "base",
            "kind": "Measure",
            "description": "Ex.: Esteira | Rejeitados. Liga o botão \"Taxa vs. média\"."
        },
        {
            "displayName": "Detalhe da coluna (opcional)",
            "name": "detalhe",
            "kind": "Measure",
            "description": "Texto mostrado no ⓘ do título da coluna. Ex.: Esteira | Etapas do Grupo"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "linhas": {
                        "max": 1
                    },
                    "colunas": {
                        "max": 1
                    },
                    "valor": {
                        "max": 1
                    },
                    "base": {
                        "max": 1
                    },
                    "detalhe": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "linhas"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "colunas",
                        "select": [
                            {
                                "bind": {
                                    "to": "valor"
                                }
                            },
                            {
                                "bind": {
                                    "to": "base"
                                }
                            },
                            {
                                "bind": {
                                    "to": "detalhe"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 60
                            }
                        }
                    }
                }
            }
        }
    ],
