{
    "dataRoles": [
        {
            "displayName": "Etapas",
            "name": "etapa",
            "kind": "Grouping",
            "description": "Uma linha por etapa do funil, na ordem da coluna (use Classificar por coluna)."
        },
        {
            "displayName": "Grupo (cor e legenda)",
            "name": "grupo",
            "kind": "Grouping",
            "description": "Opcional. Colore as barras por grupo e mostra a legenda. Ex.: Triagem, Entrevistas."
        },
        {
            "displayName": "Valor",
            "name": "valor",
            "kind": "Measure",
            "description": "Quantidade em cada etapa."
        },
        {
            "displayName": "Base do % (opcional)",
            "name": "base",
            "kind": "Measure",
            "description": "Denominador do \"% do total\". Se vazio, usa o valor da primeira etapa."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "etapa": {
                        "max": 1
                    },
                    "valor": {
                        "max": 1
                    },
                    "base": {
                        "max": 1
                    },
                    "grupo": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "etapa"
                            }
                        },
                        {
                            "bind": {
                                "to": "grupo"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 200
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "valor"
                            }
                        },
                        {
                            "bind": {
                                "to": "base"
                            }
                        }
                    ]
                }
            }
        }
    ],
