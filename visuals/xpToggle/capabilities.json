{
    "dataRoles": [
        {
            "displayName": "Opções",
            "name": "opcao",
            "kind": "Grouping",
            "description": "Coluna de uma tabela de opções sem relação (ex.: dModo[modo]). Classifique pela coluna de ordem."
        },
        {
            "displayName": "Texto de contexto (opcional)",
            "name": "contexto",
            "kind": "Measure",
            "description": "Texto mostrado ao lado ou embaixo do botão, da opção ativa. Use **texto** para negrito. Ex.: Esteira | Texto do Modo"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "opcao": {
                        "max": 1
                    },
                    "contexto": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "opcao"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 20
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "contexto"
                            }
                        }
                    ]
                }
            }
        }
    ],
