{
    "dataRoles": [
        {
            "displayName": "Data",
            "name": "data",
            "kind": "Grouping",
            "description": "Coluna de data por dia (ex.: _dCALENDARIO[Data]). O visual agrupa em semana, mês, trimestre e ano."
        },
        {
            "displayName": "Série 1: primeira linha",
            "name": "s1a",
            "kind": "Measure",
            "description": "Ex.: Esteira | Aprovados por Data"
        },
        {
            "displayName": "Série 1: segunda linha",
            "name": "s1b",
            "kind": "Measure",
            "description": "Ex.: Esteira | Rejeitados por Data"
        },
        {
            "displayName": "Série 2: primeira linha",
            "name": "s2a",
            "kind": "Measure",
            "description": "Ex.: Esteira | Entrevistas Criadas"
        },
        {
            "displayName": "Série 2: segunda linha",
            "name": "s2b",
            "kind": "Measure",
            "description": "Ex.: Esteira | Entrevistas Agendadas (pode ter datas futuras)"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "data": {
                        "max": 1
                    },
                    "s1a": {
                        "max": 1
                    },
                    "s1b": {
                        "max": 1
                    },
                    "s2a": {
                        "max": 1
                    },
                    "s2b": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "data"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "s1a"
                            }
                        },
                        {
                            "bind": {
                                "to": "s1b"
                            }
                        },
                        {
                            "bind": {
                                "to": "s2a"
                            }
                        },
                        {
                            "bind": {
                                "to": "s2b"
                            }
                        }
                    ]
                }
            }
        }
    ],
