{
    "dataRoles": [
        {
            "displayName": "Recortes (um botão por campo)",
            "name": "dims",
            "kind": "Grouping",
            "description": "Ex.: recruiter_name, dEtapa[stage_name], job_name, esteira, especialidade. A ordem aqui é a ordem dos botões."
        },
        {
            "displayName": "Aplicações com alerta",
            "name": "apps",
            "kind": "Measure",
            "description": "Esteira | Aplicações com Alerta"
        },
        {
            "displayName": "Base (aplicações do recorte)",
            "name": "base",
            "kind": "Measure",
            "description": "Esteira | DQ Onde Base"
        },
        {
            "displayName": "Composição por tipo",
            "name": "composicao",
            "kind": "Measure",
            "description": "Esteira | DQ Onde Composição (texto ordem|tipo=n;;…)"
        },
        {
            "displayName": "Título",
            "name": "titulo",
            "kind": "Measure",
            "description": "Esteira | DQ Onde Título"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "dims": {
                        "max": 6
                    },
                    "apps": {
                        "max": 1
                    },
                    "base": {
                        "max": 1
                    },
                    "composicao": {
                        "max": 1
                    },
                    "titulo": {
                        "max": 1
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "dims"
                            }
                        },
                        {
                            "for": {
                                "in": "apps"
                            }
                        },
                        {
                            "for": {
                                "in": "base"
                            }
                        },
                        {
                            "for": {
                                "in": "composicao"
                            }
                        },
                        {
                            "for": {
                                "in": "titulo"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "objects": {
        "general": {
            "properties": {
                "filter": {
