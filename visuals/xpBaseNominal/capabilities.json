    "dataViewMappings": [
        {
            "conditions": [
                {
                    "link": {
                        "max": 1
                    },
                    "candidato": {
                        "max": 1
                    },
                    "vaga": {
                        "max": 1
                    },
                    "recrutador": {
                        "max": 1
                    },
                    "extras": {
                        "max": 4
                    },
                    "situacao": {
                        "max": 1
                    },
                    "etapa": {
                        "max": 1
                    },
                    "dias": {
                        "max": 1
                    },
                    "motivo": {
                        "max": 1
                    },
                    "candidatura": {
                        "max": 1
                    },
                    "saida": {
                        "max": 1
                    },
                    "sla": {
                        "max": 1
                    },
                    "entrevista": {
                        "max": 1
                    },
                    "etapaEntrevista": {
                        "max": 1
                    },
                    "jornada": {
                        "max": 1
                    },
                    "seguintes": {
                        "max": 1
                    },
                    "noPeriodo": {
                        "max": 1
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "link"
                            }
                        },
                        {
                            "for": {
                                "in": "candidato"
                            }
                        },
                        {
                            "for": {
                                "in": "vaga"
                            }
                        },
                        {
                            "for": {
                                "in": "recrutador"
                            }
                        },
                        {
                            "for": {
                                "in": "extras"
                            }
                        },
                        {
                            "bind": {
                                "to": "situacao"
                            }
                        },
                        {
                            "bind": {
                                "to": "etapa"
                            }
                        },
                        {
                            "bind": {
                                "to": "dias"
                            }
                        },
                        {
                            "bind": {
                                "to": "motivo"
                            }
                        },
                        {
                            "bind": {
                                "to": "candidatura"
                            }
                        },
                        {
                            "bind": {
                                "to": "saida"
                            }
                        },
                        {
                            "bind": {
                                "to": "sla"
                            }
                        },
                        {
                            "bind": {
                                "to": "entrevista"
                            }
                        },
                        {
                            "bind": {
                                "to": "etapaEntrevista"
                            }
                        },
                        {
                            "bind": {
                                "to": "jornada"
                            }
                        },
                        {
                            "bind": {
                                "to": "seguintes"
                            }
                        },
                        {
                            "bind": {
                                "to": "noPeriodo"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 10000
                        }
                    }
                }
            }
        }
    ],
