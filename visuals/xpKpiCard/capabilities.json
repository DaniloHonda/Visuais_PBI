{
    "dataRoles": [
        {
            "displayName": "Valor do período",
            "name": "valor",
            "kind": "Measure",
            "description": "Número principal do card, respeitando os filtros da página."
        },
        {
            "displayName": "Comparação: valor atual",
            "name": "cmpAtual",
            "kind": "Measure",
            "description": "Ex.: mês corrente até hoje."
        },
        {
            "displayName": "Comparação: valor anterior",
            "name": "cmpAnterior",
            "kind": "Measure",
            "description": "Ex.: mês anterior, mesmo intervalo de dias."
        },
        {
            "displayName": "Acumulado (YTD)",
            "name": "ytd",
            "kind": "Measure"
        },
        {
            "displayName": "Meta",
            "name": "meta",
            "kind": "Measure"
        },
        {
            "displayName": "Texto de contexto",
            "name": "contexto",
            "kind": "Measure",
            "description": "Medida que retorna texto. Ex.: \"124 contratados de 178 decididos\"."
        },
        {
            "displayName": "Período do valor",
            "name": "perValor",
            "kind": "Measure",
            "description": "Texto do selo ao lado do número. Ex.: \"01/jul – 18/out\" ou \"hoje\"."
        },
        {
            "displayName": "Rótulo da comparação",
            "name": "rotCmp",
            "kind": "Measure",
            "description": "Substitui o rótulo fixo da comparação. Ex.: \"1–18 out vs set\"."
        },
        {
            "displayName": "Rótulo do acumulado",
            "name": "rotYtd",
            "kind": "Measure",
            "description": "Substitui o rótulo fixo do acumulado. Ex.: \"Desde 01/jul\"."
        },
        {
            "displayName": "Status (cor do número)",
            "name": "status",
            "kind": "Measure",
            "description": "Medida que retorna ok, atencao ou critico. Pinta o número de âmbar ou coral."
        },
        {
            "displayName": "Linha de insight",
            "name": "insight",
            "kind": "Measure",
            "description": "Texto da linha de baixo, separada por um traço. Ex.: \"onde mais acontece: Phone Screening\"."
        },
        {
            "displayName": "Explicação (ⓘ)",
            "name": "info",
            "kind": "Measure",
            "description": "Texto que aparece ao passar o mouse no ⓘ do título."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "valor": {
                        "max": 1
                    },
                    "cmpAtual": {
                        "max": 1
                    },
                    "cmpAnterior": {
                        "max": 1
                    },
                    "ytd": {
                        "max": 1
                    },
                    "meta": {
                        "max": 1
                    },
                    "contexto": {
                        "max": 1
                    },
                    "perValor": {
                        "max": 1
                    },
                    "rotCmp": {
                        "max": 1
                    },
                    "rotYtd": {
                        "max": 1
                    },
                    "status": {
                        "max": 1
                    },
                    "insight": {
                        "max": 1
                    },
                    "info": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "valor"
                            }
                        },
                        {
                            "bind": {
                                "to": "cmpAtual"
                            }
                        },
                        {
                            "bind": {
                                "to": "cmpAnterior"
                            }
                        },
                        {
                            "bind": {
                                "to": "ytd"
                            }
                        },
                        {
                            "bind": {
                                "to": "meta"
                            }
                        },
                        {
                            "bind": {
                                "to": "contexto"
                            }
                        },
                        {
                            "bind": {
                                "to": "perValor"
                            }
                        },
                        {
                            "bind": {
                                "to": "rotCmp"
                            }
                        },
                        {
                            "bind": {
                                "to": "rotYtd"
                            }
                        },
                        {
                            "bind": {
                                "to": "status"
                            }
                        },
                        {
                            "bind": {
                                "to": "insight"
                            }
                        },
                        {
                            "bind": {
                                "to": "info"
                            }
                        }
                    ]
                }
            }
        }
    ],
