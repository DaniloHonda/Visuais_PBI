{
    "dataRoles": [
        {
            "displayName": "Linhas",
            "name": "categoria",
            "kind": "Grouping",
            "description": "Uma barra por item (ex.: etapa), na ordem da coluna. Para mostrar itens sem dados: clique com o botão direito no campo → Mostrar itens sem dados."
        },
        {
            "displayName": "Partes da barra",
            "name": "partes",
            "kind": "Measure",
            "description": "De 1 a 5 medidas, empilhadas na ordem em que aparecem aqui."
        },
        {
            "displayName": "Total da linha (opcional)",
            "name": "total",
            "kind": "Measure",
            "description": "Define o comprimento da barra e o texto abaixo do nome (ex.: entraram). Se vazio, usa a soma das partes."
        },
        {
            "displayName": "Indicador à direita (opcional)",
            "name": "indicador",
            "kind": "Measure",
            "description": "Ex.: conversão da etapa."
        },
        {
            "displayName": "Texto de destaque (opcional)",
            "name": "destaque",
            "kind": "Measure",
            "description": "Medida de texto mostrada na faixa abaixo das barras. Use **texto** para negrito."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "categoria": {
                        "max": 1
                    },
                    "partes": {
                        "max": 5
                    },
                    "total": {
                        "max": 1
                    },
                    "indicador": {
                        "max": 1
                    },
                    "destaque": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "categoria"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 500
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": {
                                "in": "partes"
                            }
                        },
                        {
                            "bind": {
                                "to": "total"
                            }
                        },
                        {
                            "bind": {
                                "to": "indicador"
                            }
                        },
                        {
                            "bind": {
                                "to": "destaque"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "barras": {
