// 74 · Nominal na Fotografia, versão leve (com a XP · Tabela nominal 2.2.0) · mesmo texto da conversa (03/11/2026)
// A tabela 2.2.0 calcula "Etapa no dia", "Entrou na etapa", "Dias na etapa", faixas e o resultado no dia a partir da
// linha do tempo (jornada) e da data da foto. O Power BI só manda colunas simples (valores "~token" na linha).
// Ordem: importar a 2.2.0 → parte 1 (cabeçalho manda foto/ini/etapas/faixas) → parte 2 (linha leve).

// =========================== PARTE 1 · cabeçalho com a data da foto ===========================
DEFINE
    MEASURE '_Medidas'[Esteira | Visão Contexto Leve] =
        VAR V = SELECTEDVALUE( dVisao[visao], "Aplicações" )
        VAR Foto = [Esteira | Modo] = "Fotografia" && NOT ( V IN { "Evolução", "Entrevistas", "Alertas" } )
        VAR Dt = FORMAT( [Esteira | Data da Fotografia], "dd/mm" )
        VAR IniF = MAX( MIN( '_dCALENDARIO'[Data] ), DATE( 2026, 7, 1 ) )
        VAR PerTxt = " de " & FORMAT( IniF, "dd/mm" ) & " a " & Dt
        VAR EtTxt = IF( ISFILTERED( dEtapa[stage_name] ),
            " em " & CONCATENATEX( VALUES( dEtapa[stage_name] ), dEtapa[stage_name], ", " ), "" )
        VAR AlTxt = IF( HASONEVALUE( dAlerta[alerta] ), """" & VALUES( dAlerta[alerta] ) & """", "algum alerta" )
        VAR Faixas = "0–2 d;3–7 d;8–15 d;16–30 d;31–45 d;> 45 d"
        VAR Frase =
            IF( Foto,
                SWITCH( V,
                    "Aplicações", "aplicações que existiam em " & Dt & " (base desde 01/07)",
                    "Contratadas", "contratadas" & PerTxt & " (pela data da contratação)",
                    "Em andamento", "aplicações em andamento em " & Dt & EtTxt,
                    "Funil", "aplicações que existiam em " & Dt & " e até onde tinham chegado",
                    "Entradas por etapa", "aplicações que estiveram" & IF( EtTxt = "", " em alguma etapa", EtTxt ) & PerTxt,
                    "Rejeitados e motivos", "aplicações rejeitadas" & EtTxt & PerTxt,
                    "Andamento por faixa", "aplicações em andamento em " & Dt & ", por dias parada na etapa",
                    "SLA por etapa", "aplicações com etapa concluída" & EtTxt & PerTxt,
                    "Por recrutador", "aplicações que existiam em " & Dt,
                    "aplicações" ),
                SWITCH( V,
                    "Aplicações", "aplicações com candidatura no período",
                    "Contratadas", "contratadas · candidatura no período",
                    "Em andamento", "aplicações em andamento hoje" & EtTxt,
                    "Funil", "aplicações do período e até onde chegaram",
                    "Entradas por etapa", "aplicações que entraram" & IF( EtTxt = "", " em alguma etapa", EtTxt ),
                    "Rejeitados e motivos", "aplicações rejeitadas" & EtTxt,
                    "Andamento por faixa", "aplicações em andamento, por dias parada na etapa atual",
                    "SLA por etapa", "aplicações do período com etapa concluída" & EtTxt,
                    "Por recrutador", "aplicações do período",
                    "Evolução", "aplicações com aprovação ou rejeição no período (data do movimento)" & EtTxt,
                    "Entrevistas", "aplicações com entrevista marcada no período" & EtTxt,
                    "Alertas", "aplicações com " & AlTxt & EtTxt,
                    "aplicações" ) )
        VAR Origem = SWITCH( V,
            "Aplicações", "card Aplicações", "Contratadas", "card Contratadas", "Em andamento", "card Em andamento",
            "Funil", "Funil", "Entradas por etapa", "Entradas e aprovações por etapa",
            "Rejeitados e motivos", "Rejeitados por etapa e Motivos de saída", "Andamento por faixa", "Aplicações em andamento por etapa",
            "SLA por etapa", "SLA por etapa", "Por recrutador", "Aprovados por recrutador",
            "Evolução", "Evolução", "Entrevistas", "Entrevistas", "Alertas", "Tipos de alerta", "" )
        VAR SemEtapa = IF( Foto, ";Sem etapa no dia", "" )
        VAR Segs = SWITCH( V,
            "Contratadas", "Direto;Via pool;Dentro do pool",
            "Em andamento", "Até 45 dias;Parada há mais de 45 dias" & SemEtapa,
            "Entradas por etapa", "Aprovado;Rejeitado;Em andamento;Voltou;Saiu para outra vaga",
            "Rejeitados e motivos", "Avaliação;Declínio do candidato;Administrativo;A classificar",
            "Andamento por faixa", Faixas & SemEtapa,
            "SLA por etapa", Faixas,
            "Evolução", "Aprovou;Rejeitada;Aprovou e foi rejeitada",
            "Entrevistas", "Aprovado;Rejeitado;Sem resultado;A realizar",
            "Em andamento;Contratada;Contratada via outra vaga;Rejeitada;Declinou" )
        VAR Ordem = SWITCH( V,
            "Em andamento", "Dias na etapa", "Andamento por faixa", "Dias na etapa", "Rejeitados e motivos", "Dias na etapa",
            "Entradas por etapa", "Dias na etapa", "SLA por etapa", "Dias nas etapas",
            "Evolução", "Último movimento", "Entrevistas", "Última entrevista", "SLA (dias)" )
        // Só na Fotografia: o que a tabela 2.2.0 precisa para calcular o "no dia"
        VAR FotoTxt = IF( Foto,
            "||foto=" & FORMAT( [Esteira | Data da Fotografia], "yyyy-mm-dd" )
            & "||ini=" & FORMAT( IniF, "yyyy-mm-dd" )
            & "||etapas=" & IF( ISFILTERED( dEtapa[stage_name] ), CONCATENATEX( VALUES( dEtapa[stage_name] ), dEtapa[stage_name], ";" ) )
            & "||faixas=" & CONCATENATEX( ALL( dFaixaDias ), dFaixaDias[de] & ":" & dFaixaDias[ate] & ":" & dFaixaDias[faixa], ";", dFaixaDias[ordem], ASC ) )
        RETURN
        "visao=" & V & "||frase=" & Frase & "||origem=" & Origem & "||segs=" & Segs & "||ordem=" & Ordem & FotoTxt

EVALUATE
VAR Cal = FILTER( ALL( '_dCALENDARIO'[Data] ),
    '_dCALENDARIO'[Data] >= DATE( 2026, 10, 1 ) && '_dCALENDARIO'[Data] <= DATE( 2026, 10, 25 ) )
RETURN
CALCULATETABLE(
    ADDCOLUMNS(
        CROSSJOIN( VALUES( dModo[modo] ), FILTER( SUMMARIZE( dVisao, dVisao[ordem], dVisao[visao] ), dVisao[visao] = "Em andamento" ) ),
        "contexto", [Esteira | Visão Contexto Leve] ),
    Cal )
ORDER BY dModo[modo]


// =========================== PARTE 2 · linha da Fotografia leve (tokens) ===========================
// Redefine a mesma medida (os campos não mudam). Os "~…" são calculados pela Tabela nominal 2.2.0.
DEFINE
    MEASURE '_Medidas'[Esteira | Visão Dados Foto] =
        VAR V = SELECTEDVALUE( dVisao[visao], "Aplicações" )
        RETURN
        IF( [Esteira | Visão Na Lista Foto] = 1,
            VAR F = "yyyy-mm-dd"
            VAR D = [Esteira | Data da Fotografia]
            VAR Fim = D + 1
            VAR Sit = MAX( '13_ETAPA_RECRUTAMENTO'[situacao_app] )
            VAR StApp = MAX( '13_ETAPA_RECRUTAMENTO'[status] )
            VAR Cand = MIN( '13_ETAPA_RECRUTAMENTO'[data_aplicacao] )
            VAR Ciclo = COALESCE( MIN( '13_ETAPA_RECRUTAMENTO'[ciclo_inicio] ), Cand )
            VAR Pausa = MAX( '13_ETAPA_RECRUTAMENTO'[dias_pausa_sla] )
            VAR Mot = MAX( '13_ETAPA_RECRUTAMENTO'[rejection_reason_name] )
            VAR Tipo = MAX( '13_ETAPA_RECRUTAMENTO'[tipo_encerramento] )
            VAR Contr = MAX( '13_ETAPA_RECRUTAMENTO'[data_contratacao] )
            VAR RejEm = MAX( '13_ETAPA_RECRUTAMENTO'[rejected_at] )
            VAR AbertaD = NOT ( NOT ISBLANK( Contr ) && Contr < Fim ) && NOT ( StApp = "rejected" && NOT ( RejEm >= Fim ) )
            VAR SitD = IF( AbertaD, "Em andamento", Sit )
            VAR Saida = SWITCH( Sit, "Contratada", Contr, "Rejeitada", RejEm, "Declinou", RejEm, "Contratada via outra vaga", RejEm )
            VAR Sla = IF( NOT AbertaD && Sit = "Contratada", ROUND( MAX( '13_ETAPA_RECRUTAMENTO'[sla_esteira_dias] ), 0 ),
                IF( NOT ISBLANK( Ciclo ), MAX( 0, INT( IF( AbertaD, D, COALESCE( Saida, D ) ) - Ciclo ) - Pausa ) ) )
            VAR tSla = "||SLA (dias)=" & IF( ISBLANK( Sla ), "", "#" & Sla )
            VAR tCand = "||Candidatura=" & IF( ISBLANK( Cand ), "", "@" & FORMAT( Cand, F ) )
            VAR tHoje = "||Situação hoje=" & Sit
            VAR Base = "||Situação no dia=" & SitD & "||Etapa no dia=" & IF( AbertaD, "~etapa_dia", "~etapa_ultima" ) & tHoje & tCand & tSla
            RETURN
            SWITCH( V,
                "Aplicações",
                    "seg=" & SitD & Base & "||Motivo=" & IF( AbertaD, "", Mot ) & "||Tipo de encerramento=" & IF( AbertaD, "", Tipo ),
                "Por recrutador",
                    "seg=" & SitD & Base & "||Motivo=" & IF( AbertaD, "", Mot ),
                "Funil",
                    VAR MaxOrd = CALCULATE( MAX( '13_ETAPA_RECRUTAMENTO'[ordem_etapa] ),
                        '13_ETAPA_RECRUTAMENTO'[passagem_valida] = 1, '13_ETAPA_RECRUTAMENTO'[data_entrada_stage] < Fim,
                        REMOVEFILTERS( dEtapa ), REMOVEFILTERS( '13_ETAPA_RECRUTAMENTO'[stage_name] ) )
                    RETURN "seg=" & SitD & "||Chegou até=" & LOOKUPVALUE( dEtapa[stage_name], dEtapa[ordem], MaxOrd ) & Base,
                "Contratadas",
                    VAR Orig = MAX( '13_ETAPA_RECRUTAMENTO'[origem_contratacao] )
                    RETURN "seg=" & Orig & "||Origem=" & Orig
                        & "||Início do ciclo=" & IF( ISBLANK( Ciclo ), "", "@" & FORMAT( Ciclo, F ) ) & tCand
                        & "||Contratação=" & IF( ISBLANK( Contr ), "", "@" & FORMAT( Contr, F ) ) & tSla,
                "Em andamento",
                    "seg=~seg45||Etapa no dia=~etapa_dia||Entrou na etapa=~entrada_dia||Dias na etapa=~dias_dia" & tHoje & tCand & tSla,
                "Andamento por faixa",
                    "seg=~faixa_dia||Etapa no dia=~etapa_dia||Faixa=~faixa_dia||Entrou na etapa=~entrada_dia||Dias na etapa=~dias_dia"
                        & tHoje & tCand & tSla,
                "Rejeitados e motivos",
                    "seg=" & Tipo & "||Etapa da rejeição=~etapa_rej||Motivo=" & Mot & "||Tipo=" & Tipo
                        & "||Rejeitada em=" & IF( ISBLANK( RejEm ), "", "@" & FORMAT( RejEm, F ) ) & "||Dias na etapa=~dias_rej" & tCand & tSla,
                "Entradas por etapa",
                    "seg=~ent_res||Etapa=~ent_etapa||Resultado no dia=~ent_res||Entrada=~ent_entrada||Saída=~ent_saida||Dias na etapa=~ent_dias"
                        & tHoje & tCand & tSla
                        & "||_rej=" & IF( ISBLANK( RejEm ), "", FORMAT( RejEm, F ) ) & "||_aberta=" & IF( AbertaD, "1", "0" ),
                "SLA por etapa",
                    "seg=~sla_faixa||Etapa=~sla_etapa||Etapas concluídas=~sla_n||Entrada=~sla_entrada||Saída=~sla_saida||Dias nas etapas=~sla_dias"
                        & tHoje & tCand & tSla ) )

EVALUATE
VAR Cal = FILTER( ALL( '_dCALENDARIO'[Data] ),
    '_dCALENDARIO'[Data] >= DATE( 2026, 10, 1 ) && '_dCALENDARIO'[Data] <= DATE( 2026, 10, 25 ) )
RETURN
CALCULATETABLE(
    VAR Apps = TOPN( 3, FILTER( VALUES( '13_ETAPA_RECRUTAMENTO'[application_id] ), [Esteira | Visão Na Lista Modo] = 1 ),
        '13_ETAPA_RECRUTAMENTO'[application_id], ASC )
    RETURN ADDCOLUMNS( Apps, "dados", [Esteira | Visão Dados Modo] ),
    Cal, TREATAS( { "Fotografia" }, dModo[modo] ), TREATAS( { "Em andamento" }, dVisao[visao] ),
    '13_ETAPA_RECRUTAMENTO'[considerar] = TRUE() )
