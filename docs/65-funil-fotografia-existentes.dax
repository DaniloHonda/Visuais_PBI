// 65 · Funil no modo Fotografia = todas as aplicações que existiam em D (caso C, substitui o caso A do docs/64) · 03/11/2026
// Grupo: aplicações criadas até D (o mesmo 117.161 do card Aplicações "em 25/10"). Barras: até onde tinham chegado até D.
// Contratadas: contratadas até D. Só o último dia do período importa (o início não muda o funil). Candidatura não muda.
// Avisos já voltam vazios (docs/64). Depois de atualizar: nos 2 cards "por contratação", Período do valor → Esteira | Card Período Estoque.
DEFINE
    MEASURE '_Medidas'[Esteira | Funil Base] =
        IF( [Esteira | Modo] = "Fotografia", [Esteira | Foto Existentes], [Esteira | Candidatos] )

    MEASURE '_Medidas'[Esteira | Funil Contratadas] =
        VAR Fim = [Esteira | Data da Fotografia] + 1
        RETURN
        IF( [Esteira | Modo] = "Fotografia",
            CALCULATE( DISTINCTCOUNT( '13_ETAPA_RECRUTAMENTO'[application_id] ),
                KEEPFILTERS( NOT ISBLANK( '13_ETAPA_RECRUTAMENTO'[data_entrada_stage] ) ),
                KEEPFILTERS( '13_ETAPA_RECRUTAMENTO'[status] = "hired" ),
                KEEPFILTERS( '13_ETAPA_RECRUTAMENTO'[data_aplicacao] < Fim ),
                KEEPFILTERS( NOT ISBLANK( '13_ETAPA_RECRUTAMENTO'[data_contratacao] ) ),
                KEEPFILTERS( '13_ETAPA_RECRUTAMENTO'[data_contratacao] < Fim ) ),
            [Esteira | Contratados] )

    MEASURE '_Medidas'[Esteira | Funil Aplicações] =
        VAR Ordem = SELECTEDVALUE( dFunil[ordem_passo] )
        VAR Foto = [Esteira | Modo] = "Fotografia"
        VAR Ini = IF( Foto, DATE( 1900, 1, 1 ), MIN( '_dCALENDARIO'[Data] ) )
        VAR Fim = IF( Foto, [Esteira | Data da Fotografia] + 1, MAX( '_dCALENDARIO'[Data] ) + 1 )
        VAR FimEtapa = IF( Foto, Fim, DATE( 9999, 12, 31 ) )
        RETURN
        SWITCH( TRUE(),
            ISBLANK( Ordem ), BLANK(),
            Ordem = 999, [Esteira | Funil Contratadas],
            CALCULATE(
                DISTINCTCOUNT( '13_ETAPA_RECRUTAMENTO'[application_id] ),
                KEEPFILTERS( '13_ETAPA_RECRUTAMENTO'[data_aplicacao] >= Ini ),
                KEEPFILTERS( '13_ETAPA_RECRUTAMENTO'[data_aplicacao] < Fim ),
                KEEPFILTERS( NOT ISBLANK( '13_ETAPA_RECRUTAMENTO'[data_entrada_stage] ) ),
                KEEPFILTERS( '13_ETAPA_RECRUTAMENTO'[data_entrada_stage] < FimEtapa ),
                KEEPFILTERS( '13_ETAPA_RECRUTAMENTO'[ordem_etapa] >= Ordem ),
                REMOVEFILTERS( dEtapa ),
                REMOVEFILTERS( '13_ETAPA_RECRUTAMENTO'[stage_name] )
            ) + 0
        )

    MEASURE '_Medidas'[Esteira | Aplicações por Contratação] =
        DIVIDE( [Esteira | Funil Base], [Esteira | Funil Contratadas] )

    MEASURE '_Medidas'[Esteira | Texto Aplicações por Contratação] =
        VAR Foto = [Esteira | Modo] = "Fotografia"
        RETURN
        FORMAT( [Esteira | Funil Base], "#,0" )
            & IF( Foto, " aplicações criadas até " & FORMAT( [Esteira | Data da Fotografia], "dd/mmm", "pt-BR" ), " aplicações" )
            & " para " & FORMAT( [Esteira | Funil Contratadas], "#,0" ) & " contratações"

// Conferência 1 · funil de 01/10 a 25/10 nos dois modos (mesmo período da foto da tela)
EVALUATE
VAR Cal = FILTER( ALL( '_dCALENDARIO'[Data] ),
    '_dCALENDARIO'[Data] >= DATE( 2026, 10, 1 ) && '_dCALENDARIO'[Data] <= DATE( 2026, 10, 25 ) )
VAR T =
    CALCULATETABLE(
        ADDCOLUMNS( SUMMARIZE( dFunil, dFunil[ordem_passo], dFunil[passo] ),
            "cand", CALCULATE( [Esteira | Funil Aplicações], TREATAS( { "Candidatura" }, dModo[modo] ) ),
            "foto", CALCULATE( [Esteira | Funil Aplicações], TREATAS( { "Fotografia" }, dModo[modo] ) ) ),
        Cal, '13_ETAPA_RECRUTAMENTO'[considerar] = TRUE() )
RETURN
FILTER( T, [foto] > 0 )
ORDER BY dFunil[ordem_passo]

// Conferência 2 · cards "por contratação" nos dois modos
EVALUATE
VAR Cal = FILTER( ALL( '_dCALENDARIO'[Data] ),
    '_dCALENDARIO'[Data] >= DATE( 2026, 10, 1 ) && '_dCALENDARIO'[Data] <= DATE( 2026, 10, 25 ) )
RETURN
CALCULATETABLE(
    ADDCOLUMNS( VALUES( dModo[modo] ),
        "base", [Esteira | Funil Base],
        "contr", [Esteira | Funil Contratadas],
        "por contr", [Esteira | Aplicações por Contratação],
        "recrut", [Esteira | Recrutador por Contratação],
        "texto", [Esteira | Texto Aplicações por Contratação] ),
    Cal, '13_ETAPA_RECRUTAMENTO'[considerar] = TRUE() )
