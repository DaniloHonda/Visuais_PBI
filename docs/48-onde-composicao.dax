// =====================================================================
// 48 · Onde acontece com a composição por tipo de alerta (XP · Onde acontece 1.2.0)
// Uma medida de texto entrega a composição de cada recrutador/etapa/vaga: "ordem|tipo=quantidade;;…".
// Assim o visual não precisa de dAlerta como coluna de agrupamento (na 1.1.0 a composição não chegava).
// Uma aplicação pode ter mais de um alerta: a barra tem o comprimento do total e é dividida na proporção de cada tipo.
// Colar daqui até o fim na Exibição de consulta DAX → Executar → "Atualizar o modelo com alterações".
// =====================================================================
DEFINE
    // Tipos com pelo menos 1 aplicação no recorte; respeita o tipo clicado em Tipos de alerta.
    MEASURE '_Medidas'[Esteira | DQ Onde Composição] =
        VAR T =
            ADDCOLUMNS(
                ALLSELECTED( dAlerta[ordem], dAlerta[alerta] ),
                "@n", [Esteira | Aplicações com Alerta] )
        RETURN
        CONCATENATEX(
            FILTER( T, [@n] > 0 ),
            dAlerta[ordem] & "|" & dAlerta[alerta] & "=" & [@n],
            ";;",
            dAlerta[ordem], ASC )

    // Título: olha o tipo clicado na página.
    MEASURE '_Medidas'[Esteira | DQ Onde Título] =
        "Onde acontece: "
            & CALCULATE(
                IF( HASONEVALUE( dAlerta[alerta] ), """" & VALUES( dAlerta[alerta] ) & """", "todos os alertas" ),
                ALLSELECTED( dAlerta ) )

EVALUATE ROW( "medidas", 2 )

// Conferência: os 5 recrutadores com mais alertas e a composição de cada um
EVALUATE
TOPN( 5,
    ADDCOLUMNS(
        VALUES( '13_ETAPA_RECRUTAMENTO'[recruiter_name] ),
        "total", [Esteira | Aplicações com Alerta],
        "composição", [Esteira | DQ Onde Composição]
    ),
    [total], DESC )
