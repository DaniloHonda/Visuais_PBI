// =====================================================================
// 48 · Onde acontece com a composição por tipo de alerta (XP · Onde acontece 1.1.0)
// O visual recebe uma linha por (recorte × tipo). O total e a base vêm só na linha do 1º tipo (medidas "1x"),
// para não repetir 7 vezes; a contagem por tipo vem de Esteira | Aplicações com Alerta.
// Uma aplicação pode ter mais de um alerta: a barra tem o comprimento do total (aplicações distintas)
// e é dividida na proporção de cada tipo.
// Colar daqui até o fim na Exibição de consulta DAX → Executar → "Atualizar o modelo com alterações".
// =====================================================================
DEFINE
    // Total de aplicações com alerta do recorte (respeita o tipo clicado em Tipos de alerta).
    MEASURE '_Medidas'[Esteira | DQ Onde Apps] =
        VAR Primeiro = CALCULATE( MIN( dAlerta[ordem] ), ALLSELECTED( dAlerta ) )
        RETURN
        IF( NOT ISINSCOPE( dAlerta[alerta] ) || SELECTEDVALUE( dAlerta[ordem] ) = Primeiro,
            CALCULATE( [Esteira | Aplicações com Alerta], ALLSELECTED( dAlerta ) ) )

    // Base do % (aplicações do recorte), uma vez por recorte.
    MEASURE '_Medidas'[Esteira | DQ Onde Base 1x] =
        VAR Primeiro = CALCULATE( MIN( dAlerta[ordem] ), ALLSELECTED( dAlerta ) )
        RETURN
        IF( NOT ISINSCOPE( dAlerta[alerta] ) || SELECTEDVALUE( dAlerta[ordem] ) = Primeiro,
            [Esteira | DQ Onde Base] )

    // Título: olha o tipo clicado na página, não o tipo da linha.
    MEASURE '_Medidas'[Esteira | DQ Onde Título] =
        "Onde acontece: "
            & CALCULATE(
                IF( HASONEVALUE( dAlerta[alerta] ), """" & VALUES( dAlerta[alerta] ) & """", "todos os alertas" ),
                ALLSELECTED( dAlerta ) )

EVALUATE ROW( "medidas", 3 )

// Conferência: por recrutador, total = aplicações com alerta e soma dos tipos ≥ total (quem tem 2 alertas conta nos 2)
EVALUATE
TOPN( 5,
    ADDCOLUMNS(
        VALUES( '13_ETAPA_RECRUTAMENTO'[recruiter_name] ),
        "total", [Esteira | DQ Onde Apps],
        "com alerta", [Esteira | Aplicações com Alerta],
        "soma tipos", SUMX( VALUES( dAlerta[alerta] ), [Esteira | Aplicações com Alerta] ),
        "base", [Esteira | DQ Onde Base 1x]
    ),
    [total], DESC )
